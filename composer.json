{
  "name": "dface/argument-resolver",
  "description": "PHP library to prepare external arguments to pass to a service method",
  "keywords": [
    "Type Cast",
    "Arguments Resolver"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "phpunit/phpunit": ">=13.4",
    "dface/phpunit-customization": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "dface\\ArgumentResolver\\": [
        "lib/"
      ]
    }
  },
  "autoload-dev": {
    "psr-4": {
      "dface\\ArgumentResolver\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5"
    }
  }
}
